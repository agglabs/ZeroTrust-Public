# smtp-vrfy.ztl
# Sprawdza czy serwer SMTP obsluguje komende VRFY (user enumeration).

plugin smtp-vrfy-enabled {
    service     "smtp"
    severity    LOW
    title       "SMTP VRFY command enabled"
    description "The SMTP server responds to VRFY commands, which can be used to enumerate local user accounts on the mail host."

    probe {
        send   "VRFY root\r\n"
        expect "^25[02]"
    }
}
