include("@zerotrust/plugin");

plugin.name("FTP banner information disclosure");
plugin.description("Flags FTP banners that leak the server's local time or internal port number in the greeting.");
plugin.category("info-leak");
plugin.filter(service: "ftp");

plugin.run
{
    banner = kb.get("ftp.banner");
    if (banner == null)
    {
        return;
    }

    lower = banner.to_lower();
    leaks_time = lower.contains("local time");
    leaks_port = lower.contains("server port");

    if (!leaks_time && !leaks_port)
    {
        return;
    }

    what = "";
    if (leaks_time && leaks_port) { what = "system time and internal port number"; }
    else if (leaks_time)          { what = "system time"; }
    else                          { what = "internal port number"; }

    finding(
        severity: "low",
        title: "FTP welcome banner leaks " + what,
        description: "The FTP greeting exposes " + what + " before authentication. Attackers can use this to fingerprint the host, correlate scans, or infer time-based tokens. Disable the banner or replace it with a minimal string (e.g. Pure-FTPd 'AltLog no', 'DontResolve yes', or a custom banner).",
        evidence: banner,
        confidence: 0.95
    );
}
