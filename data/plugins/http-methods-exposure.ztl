# http-methods-exposure.ztl
# Pokazuje match_mode any - plugin trafia jesli SERWER akceptuje
# ktorakolwiek z niebezpiecznych metod HTTP.

plugin http-dangerous-methods {
    service     "http"
    severity    LOW
    match_mode  any
    title       "HTTP server accepts dangerous methods"
    description "The server accepted at least one of TRACE, PUT or DELETE. Any of these can be a hardening issue depending on the application."

    probe {
        send   "TRACE / HTTP/1.0\r\n\r\n"
        expect "^HTTP/1\\.[01] 200"
    }

    probe {
        send   "PUT /zerotrust-probe HTTP/1.0\r\nContent-Length: 0\r\n\r\n"
        expect "^HTTP/1\\.[01] 20"
    }

    probe {
        send   "DELETE /zerotrust-probe HTTP/1.0\r\n\r\n"
        expect "^HTTP/1\\.[01] 20"
    }
}
