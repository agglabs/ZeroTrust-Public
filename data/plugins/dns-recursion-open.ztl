# dns-recursion-open.ztl
# Pokazuje protocol udp - wysyla surowe zapytanie DNS przez UDP
# i sprawdza czy serwer akceptuje rekursje dla zewnetrznych domen.
#
# Zapytanie: transakcja 0x1337, flagi 0x0100 (standardowa rekursja),
# 1 pytanie o A record dla example.com IN.

plugin dns-open-recursion {
    service     "dns"
    protocol    udp
    severity    MEDIUM
    title       "DNS server allows recursive queries from the internet"
    description "The DNS server answered a recursive query for an external domain. Open resolvers can be abused for amplification attacks."

    probe {
        send   "\x13\x37\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00\x07example\x03com\x00\x00\x01\x00\x01"
        expect "\x13\x37"
    }
}
