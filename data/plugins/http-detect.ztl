include("@zerotrust/plugin");
include("@zerotrust/net");

plugin.name("HTTP service detection");
plugin.description("Detects an HTTP server by sending a GET / and checking the status line.");
plugin.category("service-detect");
plugin.filter(any: true);

plugin.run
{
    http = net::http(
        host: target.host,
        port: target.port,
        timeout_ms: 2500
    );

    response = http.request(method: "HEAD", path: "/");

    if (!response)
    {
        return;
    }

    // Reject non-HTTP responders (FTP/SMTP/etc. also send bytes when poked).
    // parse_http_response sets status only when the first line is "HTTP/x.y NNN".
    if (response.status() == 0)
    {
        return;
    }

    plugin.set_service("http");

    finding(
        severity: "info",
        title: "HTTP server detected",
        description: "Service responded to an HTTP HEAD request.",
        evidence: response.headers(),
        confidence: 0.95
    );
}
