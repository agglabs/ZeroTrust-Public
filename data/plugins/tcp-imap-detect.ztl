include("@zerotrust/plugin");
include("@zerotrust/net");

plugin.name("tcp-imap-detect");
plugin.description("Strong IMAP service discovery using the IMAP server greeting.");
plugin.category("discovery");
plugin.filter(any: true);

plugin.run {
    conn = net::tcp(
        host: target.host,
        port: target.port,
        timeout_ms: 2000
    );

    if (!conn.connected()) {
        return;
    }

    banner = conn.recv_banner(timeout_ms: 2000);
    banner = banner.trim();

    if (banner == "") {
        return;
    }

    if (!banner.starts_with("* OK")) {
        return;
    }

    if (banner.length() < 8) {
        return;
    }

    banner_lower = banner.to_lower();

    product = "";
    version = "";

    if (banner_lower.contains("dovecot")) {
        product = "Dovecot";
    } else if (banner_lower.contains("courier")) {
        product = "Courier";
    } else if (banner_lower.contains("cyrus")) {
        product = "Cyrus IMAP";
    } else if (banner_lower.contains("microsoft") &&
               banner_lower.contains("exchange")) {
        product = "Microsoft Exchange";
    } else if (banner_lower.contains("imap")) {
        product = "IMAP";
    } else {
        return;
    }

    plugin.set_service(
        "imap",
        banner: banner,
        product: product,
        version: version
    );

    kb.set_scoped(
        "port",
        "imap.banner",
        banner
    );

    kb.set_scoped(
        "port",
        "imap.product",
        product
    );

    if (version != "") {
        kb.set_scoped(
            "port",
            "imap.version",
            version
        );
    }

    finding(
        severity: "info",
        title: "IMAP service detected",
        description: "The target returned a valid IMAP server greeting.",
        evidence: banner,
        verification: "ACTIVE_CHECK",
        confidence: 0.98
    );
}