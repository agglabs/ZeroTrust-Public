include("@zerotrust/plugin");
include("@zerotrust/net");

plugin.name("tcp-smtp-detect");
plugin.description("Strong SMTP service discovery using the SMTP greeting response.");
plugin.category("discovery");
plugin.filter(any: true);

plugin.run {
    conn = net::tcp(
        host: target.host,
        port: target.port,
        timeout_ms: 2000
    );

    if (!conn.connected()) {
        return;
    }

    banner = conn.recv_banner(timeout_ms: 2000);
    banner = banner.trim();

    if (banner == "") {
        return;
    }

    if (!banner.starts_with("220")) {
        return;
    }

    if (banner.length() < 8) {
        return;
    }

    separator = banner.byte_at(3);

    if (separator != 32 && separator != 45) {
        return;
    }

    banner_lower = banner.to_lower();

    product = "";
    version = "";

    if (banner_lower.contains("postfix")) {
        product = "Postfix";
    } else if (banner_lower.contains("exim")) {
        product = "Exim";
    } else if (banner_lower.contains("sendmail")) {
        product = "Sendmail";
    } else if (banner_lower.contains("microsoft") &&
               banner_lower.contains("exchange")) {
        product = "Microsoft Exchange";
    } else if (banner_lower.contains("smtp")) {
        product = "SMTP";
    } else {
        return;
    }

    plugin.set_service(
        "smtp",
        banner: banner,
        product: product,
        version: version
    );

    kb.set_scoped(
        "port",
        "smtp.banner",
        banner
    );

    kb.set_scoped(
        "port",
        "smtp.product",
        product
    );

    if (version != "") {
        kb.set_scoped(
            "port",
            "smtp.version",
            version
        );
    }

    finding(
        severity: "info",
        title: "SMTP service detected",
        description: "The target returned a valid SMTP greeting and the response contained an SMTP server identifier.",
        evidence: banner,
        verification: "ACTIVE_CHECK",
        confidence: 0.98
    );
}