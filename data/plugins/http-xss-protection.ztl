include("@zerotrust/plugin");
include("@zerotrust/net");

plugin.name("HTTP X-XSS-Protection Header");
plugin.description("Checks whether the HTTP response contains the X-XSS-Protection header.");
plugin.category("web");
plugin.filter(service: "http");

plugin.run
{
    http = net::http(
        host: target.host,
        port: target.port
    );

    response = http.request(
        method: "HEAD",
        path: "/"
    );

    if (!response)
    {
        return;
    }

    header = response.header("X-XSS-Protection");

    if (!header.exists())
    {
        finding(
            severity: "info",
            title: "X-XSS-Protection header is missing",
            description: "The HTTP server does not return the X-XSS-Protection header.",
            evidence: response.headers(),
            confidence: 0.99
        );

        return;
    }

    if (header.value() == "0")
    {
        finding(
            severity: "info",
            title: "X-XSS-Protection is disabled",
            description: "The X-XSS-Protection header explicitly disables the browser XSS filter.",
            evidence: header.value(),
            confidence: 0.99
        );

        return;
    }
}
