# ftp-anonymous.ztl
# Sprawdza czy serwer FTP akceptuje logowanie jako 'anonymous'.

plugin ftp-anonymous {
    service     "ftp"
    severity    HIGH
    title       "Anonymous FTP login allowed"
    description "The FTP server accepted a login with the username 'anonymous'. This exposes any files the anonymous account can read and often indicates an unintended misconfiguration."

    probe {
        send   "USER anonymous\r\n"
        expect "^331"
    }

    probe {
        send   "PASS zerotrust@example.com\r\n"
        expect "^230"
    }
}
