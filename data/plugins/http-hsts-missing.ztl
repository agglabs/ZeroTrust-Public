# http-hsts-missing.ztl
# Pokazuje 'expect_not' - plugin trafia gdy odpowiedz NIE zawiera
# naglowka Strict-Transport-Security.

plugin http-hsts-missing {
    service     "http"
    severity    MEDIUM
    title       "HSTS Missing From HTTP Server (RFC 6797)"
    description "The web server does not send the Strict-Transport-Security header. HSTS instructs browsers to communicate only over HTTPS. The lack of it allows downgrade attacks, SSL-stripping and weakens cookie protection. Configure the server to send this header, ideally over HTTPS."

    probe {
        send        "GET / HTTP/1.0\r\nHost: zerotrust\r\nConnection: close\r\n\r\n"
        expect      "^HTTP/1\\.[01] "
        expect_not  "[Ss]trict-[Tt]ransport-[Ss]ecurity"
    }
}
