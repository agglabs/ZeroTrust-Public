include("@zerotrust/plugin");

plugin.name("SSH version info");
plugin.description("Reads the SSH banner recorded by ssh-detect and reports the software/version.");
plugin.category("info");
plugin.filter(service: "ssh");

plugin.run
{
    banner = kb.get("ssh.banner");

    if (banner == null)
    {
        return;
    }

    // Typical banner: "SSH-2.0-OpenSSH_9.6p1 Ubuntu-3ubuntu13.5"
    dash = banner.index_of("-");
    if (dash < 0)
    {
        return;
    }

    rest = banner.slice(dash + 1);
    dash2 = rest.index_of("-");
    if (dash2 < 0)
    {
        return;
    }

    proto = rest.slice(0, dash2);
    software = rest.slice(dash2 + 1);

    kb.set("ssh.protocol", proto);
    kb.set("ssh.software", software);

    finding(
        severity: "info",
        title: "SSH version banner",
        description: "SSH protocol " + proto + " advertised by " + software,
        evidence: banner,
        confidence: 0.99
    );
}
