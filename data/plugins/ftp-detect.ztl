include("@zerotrust/plugin");
include("@zerotrust/net");

plugin.name("FTP service detection");
plugin.description("Detects an FTP server on any port by reading the 220 welcome banner.");
plugin.category("service-detect");
plugin.filter(any: true);

plugin.run
{
    tcp = net::tcp(
        host: target.host,
        port: target.port,
        timeout_ms: 2000
    );

    if (!tcp.connected())
    {
        return;
    }

    banner = tcp.recv_banner(timeout_ms: 2000);

    if (banner == "")
    {
        return;
    }

    if (!banner.starts_with("220"))
    {
        return;
    }

    // Cheap heuristic to separate FTP 220 from SMTP 220:
    // SMTP banners tend to contain "SMTP", "ESMTP", "mail".
    lower = banner.to_lower();
    if (lower.contains("smtp") || lower.contains("esmtp") || lower.contains("mail"))
    {
        return;
    }

    trimmed = banner.trim();
    plugin.set_service("ftp", banner: trimmed);
    kb.set("ftp.banner", trimmed);

    finding(
        severity: "info",
        title: "FTP server detected",
        description: "Service responded with an FTP 220 banner. Works on any port.",
        evidence: trimmed,
        confidence: 0.95
    );
}
