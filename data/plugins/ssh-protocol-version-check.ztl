include("@zerotrust/plugin");
include("@zerotrust/net");

plugin.name("ssh-protocol-version-check");
plugin.description("Checks the SSH protocol version advertised by the server.");
plugin.category("vulnerability");
plugin.filter(service: "ssh");

plugin.run {
    conn = net::tcp(
        host: target.host,
        port: target.port,
        timeout_ms: 2000
    );

    if (!conn.connected()) {
        return;
    }

    banner = conn.recv_banner(timeout_ms: 2000);
    banner = banner.trim();

    if (banner == "") {
        return;
    }

    if (!banner.starts_with("SSH-")) {
        return;
    }

    if (banner.length() < 8) {
        return;
    }

    protocol = banner.slice(4, 3);

    if (protocol == "2.0") {
        finding(
            severity: "info",
            title: "SSH protocol 2.0 detected",
            description: "The SSH server advertises SSH protocol version 2.0.",
            evidence: banner,
            verification: "ACTIVE_CHECK",
            confidence: 0.99
        );

        kb.set_scoped(
            "port",
            "ssh.protocol",
            protocol
        );

        return;
    }

    if (protocol == "1.99") {
        finding(
            severity: "medium",
            title: "Legacy SSH protocol compatibility detected",
            description: "The SSH server advertises protocol version 1.99, indicating compatibility with legacy SSH protocol behavior.",
            evidence: banner,
            verification: "ACTIVE_CHECK",
            confidence: 0.98,
            remediation: "Disable legacy SSH protocol compatibility and require SSH protocol version 2.0."
        );

        kb.set_scoped(
            "port",
            "ssh.protocol",
            protocol
        );

        return;
    }

    if (protocol == "1.0" || protocol == "1.1") {
        finding(
            severity: "high",
            title: "Legacy SSH protocol version detected",
            description: "The SSH server advertises an obsolete SSH protocol version.",
            evidence: banner,
            verification: "ACTIVE_CHECK",
            confidence: 0.99,
            remediation: "Disable SSH protocol version 1.x and require SSH protocol version 2.0."
        );

        kb.set_scoped(
            "port",
            "ssh.protocol",
            protocol
        );

        return;
    }

    finding(
        severity: "info",
        title: "Unknown SSH protocol version",
        description: "The SSH server returned an SSH identification banner with an unrecognized protocol version.",
        evidence: banner,
        verification: "ACTIVE_CHECK",
        confidence: 0.90
    );
}