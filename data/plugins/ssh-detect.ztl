include("@zerotrust/plugin");
include("@zerotrust/net");

plugin.name("SSH service detection");
plugin.description("Detects an SSH server on any port by reading the connection banner.");
plugin.category("service-detect");
plugin.filter(any: true);

plugin.run
{
    tcp = net::tcp(
        host: target.host,
        port: target.port,
        timeout_ms: 2000
    );

    if (!tcp.connected())
    {
        return;
    }

    banner = tcp.recv_banner(timeout_ms: 2000);

    if (banner == "")
    {
        return;
    }

    if (!banner.starts_with("SSH-"))
    {
        return;
    }

    trimmed = banner.trim();
    plugin.set_service("ssh", banner: trimmed);
    kb.set("ssh.banner", trimmed);

    finding(
        severity: "info",
        title: "SSH server detected",
        description: "Service responded with an SSH banner. Works on any port (22, 22222, ...).",
        evidence: banner.trim(),
        confidence: 0.99
    );
}
