# tls-old-protocol-warning.ztl
# Pokazuje uzycie KB - odczytuje dane zapisane wczesniej przez native TLS check.
# Ten plugin nie robi WLASNEGO handshake'u TLS - polega calkowicie na wyniku
# run_tls_checks, ktory zapisal do KB pod kluczem "port/${port}/tls/protocol_version".

plugin tls-legacy-protocol-flag {
    require port/443/tls/protocol_version matches "TLSv1(\\.[01])?$"

    severity    MEDIUM
    title       "Legacy TLS protocol observed on port 443 (${port/443/tls/protocol_version})"
    description "Native TLS handshake negotiated ${port/443/tls/protocol_version} which is deprecated (RFC 8996). Enforce TLS 1.2+ on this listener. Certificate subject on file: ${port/443/tls/cert_subject}."

    probe {
        send   ""
        expect ".*"
    }
}
