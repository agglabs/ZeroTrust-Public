include("@zerotrust/plugin");
include("@zerotrust/net");

plugin.name("ssh-version-fingerprint");
plugin.description("Detailed SSH software, version and distribution fingerprinting from the SSH identification banner.");
plugin.category("fingerprint");
plugin.filter(service: "ssh");

plugin.run {
    conn = net::tcp(
        host: target.host,
        port: target.port,
        timeout_ms: 2000
    );

    if (!conn.connected()) {
        return;
    }

    banner = conn.recv_banner(timeout_ms: 2000);
    banner = banner.trim();

    if (banner == "") {
        return;
    }

    if (!banner.starts_with("SSH-")) {
        return;
    }

    if (banner.length() < 9) {
        return;
    }

    protocol = banner.slice(4, 3);

    if (protocol != "2.0" && protocol != "1.99") {
        return;
    }

    /*
     * SSH identification:
     *
     * SSH-2.0-OpenSSH_8.9p1 Ubuntu-3ubuntu0.17
     *
     * Everything after SSH-2.0- is the software identification.
     */
    software = banner.slice(
        8,
        banner.length() - 8
    );

    software = software.trim();

    if (software == "") {
        return;
    }

    product = "";
    version = "";
    distribution = "";
    distribution_build = "";

    /*
     * OpenSSH
     *
     * Examples:
     *
     * OpenSSH_8.9p1
     * OpenSSH_8.9p1 Ubuntu-3ubuntu0.17
     * OpenSSH_9.6p1 Ubuntu-3ubuntu13.13
     */
    if (software.starts_with("OpenSSH_")) {
        product = "OpenSSH";

        version_start = 8;
        version_data = software.slice(
            version_start,
            software.length() - version_start
        );

        space = version_data.index_of(" ");

        if (space >= 0) {
            version = version_data.slice(
                0,
                space
            );

            distro_data = version_data.slice(
                space + 1,
                version_data.length() - space - 1
            );

            distro_data = distro_data.trim();

            /*
             * Ubuntu commonly appears as:
             *
             * Ubuntu-3ubuntu0.17
             *
             * Ubuntu_...
             *
             * Ubuntu
             */
            if (distro_data.starts_with("Ubuntu-")) {
                distribution = "Ubuntu";

                distribution_build = distro_data.slice(
                    7,
                    distro_data.length() - 7
                );
            } else if (distro_data.starts_with("Ubuntu_")) {
                distribution = "Ubuntu";

                distribution_build = distro_data.slice(
                    7,
                    distro_data.length() - 7
                );
            } else if (distro_data.starts_with("Debian-")) {
                distribution = "Debian";

                distribution_build = distro_data.slice(
                    7,
                    distro_data.length() - 7
                );
            } else if (distro_data.starts_with("Debian_")) {
                distribution = "Debian";

                distribution_build = distro_data.slice(
                    7,
                    distro_data.length() - 7
                );
            } else if (distro_data.starts_with("FreeBSD-")) {
                distribution = "FreeBSD";

                distribution_build = distro_data.slice(
                    8,
                    distro_data.length() - 8
                );
            } else if (distro_data.starts_with("FreeBSD_")) {
                distribution = "FreeBSD";

                distribution_build = distro_data.slice(
                    8,
                    distro_data.length() - 8
                );
            } else if (distro_data.starts_with("Amazon-")) {
                distribution = "Amazon Linux";

                distribution_build = distro_data.slice(
                    7,
                    distro_data.length() - 7
                );
            } else if (distro_data.starts_with("Rocky-")) {
                distribution = "Rocky Linux";

                distribution_build = distro_data.slice(
                    6,
                    distro_data.length() - 6
                );
            } else if (distro_data.starts_with("AlmaLinux-")) {
                distribution = "AlmaLinux";

                distribution_build = distro_data.slice(
                    10,
                    distro_data.length() - 10
                );
            } else if (distro_data.starts_with("CentOS-")) {
                distribution = "CentOS";

                distribution_build = distro_data.slice(
                    7,
                    distro_data.length() - 7
                );
            } else if (distro_data.starts_with("RHEL-")) {
                distribution = "RHEL";

                distribution_build = distro_data.slice(
                    5,
                    distro_data.length() - 5
                );
            } else {
                /*
                 * Unknown suffix.
                 *
                 * Keep the raw suffix rather than inventing a
                 * distribution identity.
                 */
                distribution = "";
                distribution_build = distro_data;
            }
        } else {
            version = version_data;
        }
    }

    /*
     * Dropbear
     *
     * Example:
     * dropbear_2022.83
     */
    else if (software.starts_with("dropbear_")) {
        product = "Dropbear";

        version = software.slice(
            9,
            software.length() - 9
        );
    }

    /*
     * PuTTY SSH server/client fingerprints.
     */
    else if (software.starts_with("PuTTY_")) {
        product = "PuTTY";

        version = software.slice(
            6,
            software.length() - 6
        );
    } else if (software.starts_with("PuTTY")) {
        product = "PuTTY";
    }

    /*
     * libssh fingerprints.
     */
    else if (software.starts_with("libssh")) {
        product = "libssh";

        version_data = software.slice(
            6,
            software.length() - 6
        );

        if (version_data.starts_with("_")) {
            version = version_data.slice(
                1,
                version_data.length() - 1
            );
        } else if (version_data.starts_with("-")) {
            version = version_data.slice(
                1,
                version_data.length() - 1
            );
        }
    }

    /*
     * Unknown SSH implementation.
     *
     * Do not guess a product.
     */
    if (product == "") {
        product = "SSH";
    }

    /*
     * Preserve the authoritative SSH service state while enriching
     * its fingerprint information.
     */
    plugin.set_service(
        "ssh",
        banner: banner,
        product: product,
        version: version
    );

    kb.set_scoped(
        "port",
        "ssh.protocol",
        protocol
    );

    kb.set_scoped(
        "port",
        "ssh.banner",
        banner
    );

    kb.set_scoped(
        "port",
        "ssh.software",
        software
    );

    kb.set_scoped(
        "port",
        "ssh.product",
        product
    );

    if (version != "") {
        kb.set_scoped(
            "port",
            "ssh.version",
            version
        );
    }

    if (distribution != "") {
        kb.set_scoped(
            "port",
            "ssh.distribution",
            distribution
        );
    }

    if (distribution_build != "") {
        kb.set_scoped(
            "port",
            "ssh.distribution_build",
            distribution_build
        );
    }

    /*
     * Informational fingerprint only.
     *
     * This is not a vulnerability determination.
     */
    finding(
        severity: "info",
        title: "SSH software fingerprinted",
        description: "The SSH identification banner was parsed to determine the SSH implementation, version and distribution-specific build information.",
        evidence: banner,
        verification: "ACTIVE_CHECK",
        confidence: 0.99
    );
}